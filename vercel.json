{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/finbrain", "destination": "/finbrain/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/finbrain", "destination": "https://finbrain-frontend-sigma.vercel.app/" },
    { "source": "/finbrain/:path*", "destination": "https://finbrain-frontend-sigma.vercel.app/:path*" },
    { "source": "/agent/:path*", "destination": "https://finbrain-agent.vercel.app/:path*" },
    { "source": "/websearch/:path*", "destination": "https://web-search-agent-rho.vercel.app/:path*" }
  ]
}
